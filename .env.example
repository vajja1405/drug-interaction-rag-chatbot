# ─────────────────────────────────────────────────────────────────────────────
# Drug Interaction AI – Environment Configuration
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (OpenAI or any OpenAI-compatible endpoint) ───────────────────────────
OPENAI_API_KEY=sk-your-key-here

# Use OpenAI:
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ── OR – local Ollama (uncomment & restart) ───────────────────────────────────
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=ollama
# LLM_MODEL=llama3

# ── OR – Groq (uncomment & restart) ──────────────────────────────────────────
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_API_KEY=gsk_your-groq-key
# LLM_MODEL=llama3-70b-8192

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── RAG settings ──────────────────────────────────────────────────────────────
RAG_TOP_K=5
SIMILARITY_THRESHOLD=0.55

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
MAX_DRUGS_PER_REQUEST=20
RATE_LIMIT_PER_MINUTE=30
